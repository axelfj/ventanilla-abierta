---
---
{
  "name": "{{ site.title }}",
  "short_name": "Ventanilla",
  "description": "{{ site.description }}",
  "lang": "es",
  "start_url": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0b6e4f",
  "icons": [
    { "src": "{{ '/assets/img/icono-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/icono-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" },
    { "src": "{{ '/assets/img/icono.svg' | relative_url }}", "sizes": "any", "type": "image/svg+xml" }
  ]
}
